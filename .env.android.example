# Copy to .env.android.local. Public values only; never include backend secrets.
# Blank values produce an explicitly unconfigured debug app, not a fake login.
VITE_API_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_AUTH_REDIRECT_URL=com.urjaai.app://auth
# For real devices use public HTTPS endpoints, not the laptop's localhost.
