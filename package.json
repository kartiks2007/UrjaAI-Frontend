{
  "name": "urjaai-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "android:web": "node scripts/android-web.mjs",
    "android:sync": "node scripts/cap.mjs sync android",
    "android:open": "node scripts/cap.mjs open android",
    "android:run": "node scripts/cap.mjs run android",
    "test:mobile": "playwright test --config playwright.mobile.config.ts",
    "local": "node scripts/local.mjs",
    "test:integration": "playwright test --config playwright.integration.config.ts",
    "dev": "vite --configLoader native --host 127.0.0.1",
    "review": "node scripts/review.mjs",
    "build": "tsc -b && vite build --configLoader native",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run --configLoader native src/test",
    "test:e2e": "playwright test",
    "preview": "vite preview --configLoader native --host 127.0.0.1"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "8.5.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@supabase/supabase-js": "^2.57.0",
    "@tanstack/react-query": "^5.87.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.0",
    "recharts": "^3.2.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.1.13",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
